<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="APP_NAME" value="catalogo"/>

    <springProfile name="default,prod">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeContext>false</includeContext>
                <includeMdc>true</includeMdc>
                <shortenedLoggerNameLength>39</shortenedLoggerNameLength>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <level>level</level>
                    <logger>logger</logger>
                    <thread>thread</thread>
                    <message>message</message>
                    <exception>exception</exception>
                </fieldNames>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="dev,local">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [cid:%X{correlationId}] %-5level %logger{36} - %msg%n%ex{short}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="com.example.catalogo" level="INFO"/>
    <logger name="org.springframework.graphql" level="WARN"/>
    <logger name="graphql.execution" level="WARN"/>
</configuration>
